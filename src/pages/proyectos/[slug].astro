---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const allProjects = projects;
const currentIndex = allProjects.findIndex(p => p.slug === project.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
---
<BaseLayout
  title={`${project.title} | Proyectos | ELECDIS`}
  description={`${project.title} – ${project.description}`}
  pageUrl={`/proyectos/${project.slug}/`}
>
  <Header currentPath="/proyectos/" />

  <main id="main-content">
    <!-- Page hero -->
    <div class="page-hero">
      <div class="container page-hero__content">
        <nav aria-label="Ruta de navegación" class="breadcrumb">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            <li><a href="/proyectos/">Proyectos</a></li>
            <li aria-current="page">{project.title}</li>
          </ol>
        </nav>
        <span class="project-sector-badge">{project.sector}</span>
        <h1 class="page-hero__title">{project.title}</h1>
      </div>
    </div>

    <section class="section project-detail" aria-label="Detalle del proyecto">
      <div class="container project-detail__layout">

        <!-- Galería -->
        <div class="gallery" aria-label="Galería de imágenes del proyecto">
          <!-- Imagen principal -->
          <button
            class="gallery__main"
            data-lightbox-trigger="0"
            aria-label={`Ampliar: ${project.images[0].alt}`}
          >
            <div class="img-placeholder gallery__cover" aria-label={project.images[0].alt}>
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>{project.images[0].alt}</span>
            </div>
            <span class="gallery__expand-hint" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              Ampliar
            </span>
          </button>

          <!-- Miniaturas -->
          {project.images.length > 1 && (
            <div class="gallery__thumbs" role="list" aria-label="Miniaturas">
              {project.images.slice(1).map((img, i) => (
                <button
                  class="gallery__thumb"
                  data-lightbox-trigger={String(i + 1)}
                  aria-label={`Ver imagen: ${img.alt}`}
                  role="listitem"
                >
                  <div class="img-placeholder" aria-label={img.alt} style="min-height:100px">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <span style="font-size:0.65rem">{img.alt}</span>
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Info del proyecto -->
        <aside class="project-info" aria-label="Información del proyecto">
          <dl class="project-info__list">
            <div class="project-info__item">
              <dt>Cliente</dt>
              <dd>{project.client}</dd>
            </div>
            <div class="project-info__item">
              <dt>Ubicación</dt>
              <dd>{project.location}</dd>
            </div>
            <div class="project-info__item">
              <dt>Año</dt>
              <dd>{project.year}</dd>
            </div>
            <div class="project-info__item">
              <dt>Sector</dt>
              <dd>{project.sector}</dd>
            </div>
          </dl>

          <div class="project-info__desc">
            <h2 class="project-info__desc-title">Descripción</h2>
            <p>{project.description}</p>
          </div>

          <div class="project-info__ctas">
            <a href="/#contacto" class="btn btn--primary">Cotizar un proyecto similar</a>
          </div>
        </aside>
      </div>

      <!-- Navegación entre proyectos -->
      <div class="container">
        <nav class="project-nav" aria-label="Proyecto anterior / siguiente">
          {prevProject ? (
            <a href={`/proyectos/${prevProject.slug}/`} class="project-nav__btn project-nav__btn--prev">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>
                <small>Anterior</small>
                {prevProject.title}
              </span>
            </a>
          ) : <div />}

          {nextProject ? (
            <a href={`/proyectos/${nextProject.slug}/`} class="project-nav__btn project-nav__btn--next">
              <span>
                <small>Siguiente</small>
                {nextProject.title}
              </span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ) : <div />}
        </nav>
      </div>
    </section>
  </main>

  <!-- Lightbox -->
  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Vista de imagen ampliada"
    hidden
  >
    <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Muestra placeholder ya que no hay imágenes reales -->
    <div class="lightbox__content">
      <div class="lightbox__placeholder" id="lightbox-img">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span id="lightbox-caption">Imagen del proyecto</span>
      </div>
    </div>

    <div class="lightbox__nav">
      <button class="lightbox__nav-btn" id="lightbox-prev" aria-label="Imagen anterior">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <span class="lightbox__counter" id="lightbox-counter">1 / {project.images.length}</span>
      <button class="lightbox__nav-btn" id="lightbox-next" aria-label="Imagen siguiente">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
/* Page hero */
.page-hero {
  background: var(--color-primary);
  padding-top: calc(68px + var(--space-12));
  padding-bottom: var(--space-12);
  color: #fff;
}

.breadcrumb ol {
  display: flex;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}
.breadcrumb li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); }
.breadcrumb a { color: rgba(255,255,255,0.7); }
.breadcrumb a:hover { color: var(--color-accent); }

.project-sector-badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semi);
  color: var(--color-accent);
  background: rgba(245,166,35,0.15);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-3);
}

.page-hero__title {
  font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
  font-weight: var(--weight-bold);
}

/* Detail layout */
.project-detail__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  align-items: start;
}

/* Gallery */
.gallery__main {
  display: block;
  width: 100%;
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-3);
  cursor: zoom-in;
}

.gallery__cover {
  height: 360px;
  border-radius: 0;
  border: none;
  transition: filter var(--transition);
}
.gallery__main:hover .gallery__cover { filter: brightness(0.92); }

.gallery__expand-hint {
  position: absolute;
  bottom: var(--space-3);
  right: var(--space-3);
  background: rgba(11,31,75,0.8);
  color: #fff;
  font-size: var(--text-xs);
  font-weight: var(--weight-semi);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: var(--space-1);
  opacity: 0;
  transition: opacity var(--transition);
}
.gallery__main:hover .gallery__expand-hint { opacity: 1; }

.gallery__thumbs {
  display: flex;
  gap: var(--space-3);
}

.gallery__thumb {
  flex: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: zoom-in;
  transition: transform var(--transition), opacity var(--transition);
}
.gallery__thumb:hover { transform: scale(1.03); opacity: 0.85; }

/* Project info */
.project-info__list {
  background: var(--color-bg-alt);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-5);
  margin-bottom: var(--space-6);
}

.project-info__item dt {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-1);
}
.project-info__item dd {
  font-size: var(--text-base);
  font-weight: var(--weight-semi);
  color: var(--color-text);
}

.project-info__desc {
  margin-bottom: var(--space-6);
}
.project-info__desc-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.project-info__desc p {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

/* Project nav */
.project-nav {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
  padding-block: var(--space-8);
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-8);
}

.project-nav__btn {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  max-width: 220px;
}
.project-nav__btn:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-sm);
  background: var(--color-bg-alt);
}
.project-nav__btn span { display: flex; flex-direction: column; gap: 2px; }
.project-nav__btn small { font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
.project-nav__btn--next { margin-left: auto; text-align: right; }
.project-nav__btn--next span { align-items: flex-end; }

/* Lightbox */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-6);
}
.lightbox[hidden] { display: none; }

.lightbox__close {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
  color: rgba(255,255,255,0.7);
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  transition: color var(--transition), background var(--transition);
}
.lightbox__close:hover { color: #fff; background: rgba(255,255,255,0.1); }

.lightbox__content {
  max-width: 900px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox__placeholder {
  width: 100%;
  min-height: 400px;
  background: rgba(255,255,255,0.05);
  border: 2px dashed rgba(255,255,255,0.15);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  color: rgba(255,255,255,0.4);
  font-size: var(--text-base);
}

.lightbox__nav {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}
.lightbox__nav-btn {
  color: rgba(255,255,255,0.7);
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  transition: color var(--transition), background var(--transition);
}
.lightbox__nav-btn:hover { color: #fff; background: rgba(255,255,255,0.1); }
.lightbox__counter {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.6);
  min-width: 60px;
  text-align: center;
}

@media (min-width: 1024px) {
  .project-detail__layout { grid-template-columns: 3fr 2fr; }
}
</style>

<script define:vars={{ images: project.images }}>
// Lightbox
const lightbox = document.getElementById('lightbox');
const lightboxClose = document.getElementById('lightbox-close');
const lightboxPrev = document.getElementById('lightbox-prev');
const lightboxNext = document.getElementById('lightbox-next');
const lightboxCaption = document.getElementById('lightbox-caption');
const lightboxCounter = document.getElementById('lightbox-counter');
let currentIndex = 0;
const total = images.length;

function openLightbox(index) {
  currentIndex = index;
  updateLightbox();
  lightbox.hidden = false;
  document.body.style.overflow = 'hidden';
  lightboxClose.focus();
}

function closeLightbox() {
  lightbox.hidden = true;
  document.body.style.overflow = '';
}

function updateLightbox() {
  if (lightboxCaption) lightboxCaption.textContent = images[currentIndex].alt;
  if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${total}`;
}

document.querySelectorAll('[data-lightbox-trigger]').forEach(btn => {
  btn.addEventListener('click', () => {
    openLightbox(parseInt(btn.dataset.lightboxTrigger ?? '0'));
  });
});

lightboxClose?.addEventListener('click', closeLightbox);
lightboxPrev?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + total) % total; updateLightbox(); });
lightboxNext?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % total; updateLightbox(); });

lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

document.addEventListener('keydown', (e) => {
  if (lightbox?.hidden) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + total) % total; updateLightbox(); }
  if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % total; updateLightbox(); }
});
</script>
