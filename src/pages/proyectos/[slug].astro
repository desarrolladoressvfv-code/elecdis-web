---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const allProjects = projects;
const currentIndex = allProjects.findIndex(p => p.slug === project.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

// Build images array: cover first, then the rest in sequential order (skipping cover)
const allImages = Array.from({ length: project.imageCount }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  return { src: `${project.imageDir}/img-${n}.jpg`, alt: `${project.title} – imagen ${i + 1}` };
});
const images = [
  { src: project.cover, alt: `${project.title} – portada` },
  ...allImages.filter(img => img.src !== project.cover),
];
---
<BaseLayout
  title={`${project.title} | Proyectos | ELECDIS`}
  description={`${project.title} – ${project.description}`}
  pageUrl={`/proyectos/${project.slug}/`}
>
  <Header currentPath="/proyectos/" />

  <main id="main-content">
    <!-- Page hero -->
    <div class="page-hero">
      <div class="container page-hero__content">
        <nav aria-label="Ruta de navegación" class="breadcrumb">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            <li><a href="/proyectos/">Proyectos</a></li>
            <li aria-current="page">{project.title}</li>
          </ol>
        </nav>
        <span class="project-sector-badge">{project.sector}</span>
        <h1 class="page-hero__title">{project.title}</h1>
      </div>
    </div>

    <section class="section project-detail" aria-label="Detalle del proyecto">
      <div class="container project-detail__layout">

        <!-- Galería -->
        <div class="gallery" aria-label="Galería de imágenes del proyecto">
          <!-- Imagen principal -->
          <button
            class="gallery__main"
            data-lightbox-trigger="0"
            aria-label={`Ampliar: ${images[0].alt}`}
          >
            <img
              src={images[0].src}
              alt={images[0].alt}
              class="gallery__cover"
              loading="eager"
              decoding="async"
            />
            <span class="gallery__expand-hint" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              Ampliar
            </span>
          </button>

          <!-- Miniaturas (siguientes 4) -->
          {images.length > 1 && (
            <div class="gallery__thumbs" role="list" aria-label="Miniaturas">
              {images.slice(1, 5).map((img, i) => (
                <button
                  class="gallery__thumb"
                  data-lightbox-trigger={String(i + 1)}
                  aria-label={`Ver imagen: ${img.alt}`}
                  role="listitem"
                >
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="gallery__thumb-img"
                    loading="lazy"
                    decoding="async"
                  />
                  {i === 3 && images.length > 5 && (
                    <div class="gallery__thumb-more">+{images.length - 5}</div>
                  )}
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Info del proyecto -->
        <aside class="project-info" aria-label="Información del proyecto">
          <dl class="project-info__list">
            <div class="project-info__item">
              <dt>Cliente</dt>
              <dd>{project.client}</dd>
            </div>
            <div class="project-info__item">
              <dt>Ubicación</dt>
              <dd>{project.location}</dd>
            </div>
            <div class="project-info__item">
              <dt>Año</dt>
              <dd>{project.year}</dd>
            </div>
            <div class="project-info__item">
              <dt>Sector</dt>
              <dd>{project.sector}</dd>
            </div>
          </dl>

          <div class="project-info__desc">
            <h2 class="project-info__desc-title">Descripción</h2>
            <p>{project.description}</p>
          </div>

          <div class="project-info__ctas">
            <button type="button" id="open-quote-modal" class="btn btn--electric proj-cta">
              Cotizar un proyecto similar
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </aside>
      </div>

      <!-- Navegación entre proyectos -->
      <div class="container">
        <nav class="project-nav" aria-label="Proyecto anterior / siguiente">
          {prevProject ? (
            <a href={`/proyectos/${prevProject.slug}/`} class="project-nav__btn project-nav__btn--prev">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>
                <small>Anterior</small>
                {prevProject.title}
              </span>
            </a>
          ) : <div />}

          {nextProject ? (
            <a href={`/proyectos/${nextProject.slug}/`} class="project-nav__btn project-nav__btn--next">
              <span>
                <small>Siguiente</small>
                {nextProject.title}
              </span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ) : <div />}
        </nav>
      </div>
    </section>
  </main>

  <!-- Lightbox -->
  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Vista de imagen ampliada"
    hidden
  >
    <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="lightbox__content">
      <img id="lightbox-img" src="" alt="" class="lightbox__img" />
    </div>

    <div class="lightbox__nav">
      <button class="lightbox__nav-btn" id="lightbox-prev" aria-label="Imagen anterior">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <span class="lightbox__counter" id="lightbox-counter">1 / {images.length}</span>
      <button class="lightbox__nav-btn" id="lightbox-next" aria-label="Imagen siguiente">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <!-- Modal de cotización -->
  <div
    class="quote-modal"
    id="quote-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="quote-modal-title"
    hidden
  >
    <div class="quote-modal__backdrop" id="quote-modal-backdrop"></div>
    <div class="quote-modal__panel">
      <button class="quote-modal__close" id="quote-modal-close" aria-label="Cerrar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <div class="quote-modal__header">
        <span class="quote-modal__eyebrow">Solicitar cotización</span>
        <h2 class="quote-modal__title" id="quote-modal-title">Cuéntanos sobre tu proyecto</h2>
        <p class="quote-modal__sub">Te responderemos en menos de 24 horas hábiles.</p>
      </div>

      <form
        class="quote-form"
        id="quote-form"
        action="https://formspree.io/f/placeholder"
        method="POST"
        novalidate
      >
        <input type="hidden" name="proyecto_referencia" id="quote-ref" value={project.title} />

        <div class="quote-form__row">
          <div class="quote-form__field">
            <label for="q-nombre">Nombre completo <span aria-hidden="true">*</span></label>
            <input type="text" id="q-nombre" name="nombre" required placeholder="Juan Pérez" autocomplete="name" />
          </div>
          <div class="quote-form__field">
            <label for="q-empresa">Empresa / Razón social</label>
            <input type="text" id="q-empresa" name="empresa" placeholder="Mi Empresa SpA" autocomplete="organization" />
          </div>
        </div>

        <div class="quote-form__row">
          <div class="quote-form__field">
            <label for="q-email">Correo electrónico <span aria-hidden="true">*</span></label>
            <input type="email" id="q-email" name="email" required placeholder="correo@ejemplo.com" autocomplete="email" />
          </div>
          <div class="quote-form__field">
            <label for="q-telefono">Teléfono</label>
            <input type="tel" id="q-telefono" name="telefono" placeholder="+56 9 1234 5678" autocomplete="tel" />
          </div>
        </div>

        <div class="quote-form__field">
          <label for="q-mensaje">Descripción del proyecto <span aria-hidden="true">*</span></label>
          <textarea id="q-mensaje" name="mensaje" required rows="4" placeholder="Describe brevemente qué necesitas: tipo de instalación, superficie aproximada, ubicación, plazos..."></textarea>
        </div>

        <div class="quote-form__ref-info">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Referencia: <strong>{project.title}</strong>
        </div>

        <button type="submit" class="btn btn--electric quote-form__submit">
          Enviar solicitud
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <div class="quote-form__success" id="quote-success" hidden>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <p>¡Mensaje enviado! Te contactaremos pronto.</p>
        </div>
      </form>
    </div>
  </div>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
/* Page hero */
.page-hero {
  background: var(--c-electric);
  padding-top: calc(76px + var(--s-12));
  padding-bottom: var(--s-12);
  color: #fff;
}

.breadcrumb ol {
  display: flex;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--s-4);
  flex-wrap: wrap;
}
.breadcrumb li:not(:last-child)::after { content: '/'; margin-left: var(--s-2); }
.breadcrumb a { color: rgba(255,255,255,0.7); }
.breadcrumb a:hover { color: #fff; }

.project-sector-badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  color: #fff;
  background: rgba(255,255,255,0.15);
  padding: var(--s-1) var(--s-3);
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--s-3);
}

.page-hero__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
  font-weight: var(--w-bold);
}

/* Detail layout */
.project-detail__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-10);
  align-items: start;
}

/* Gallery */
.gallery__main {
  display: block;
  width: 100%;
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  margin-bottom: var(--s-3);
  cursor: zoom-in;
}

.gallery__cover {
  display: block;
  width: 100%;
  height: 360px;
  object-fit: cover;
  transition: filter var(--t);
}
.gallery__main:hover .gallery__cover { filter: brightness(0.92); }

.gallery__expand-hint {
  position: absolute;
  bottom: var(--s-3);
  right: var(--s-3);
  background: rgba(0,0,0,0.65);
  color: #fff;
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  padding: var(--s-1) var(--s-3);
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: var(--s-1);
  opacity: 0;
  transition: opacity var(--t);
}
.gallery__main:hover .gallery__expand-hint { opacity: 1; }

.gallery__thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-2);
}

.gallery__thumb {
  position: relative;
  border-radius: var(--r-sm);
  overflow: hidden;
  cursor: zoom-in;
  aspect-ratio: 4/3;
  transition: transform var(--t), opacity var(--t);
}
.gallery__thumb:hover { transform: scale(1.03); opacity: 0.85; }

.gallery__thumb-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery__thumb-more {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: var(--text-lg);
  font-weight: var(--w-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Project info */
.project-info__list {
  background: var(--c-bg-2);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-5);
  margin-bottom: var(--s-6);
  border: 1px solid var(--c-border);
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}

.project-info__item {
  border-left: 2px solid var(--c-electric);
  padding-left: var(--s-3);
}
.project-info__item dt {
  font-size: var(--text-xs);
  color: var(--c-text-faint);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--s-1);
}
.project-info__item dd {
  font-size: var(--text-base);
  font-weight: var(--w-semi);
  color: var(--c-text);
}

.project-info__desc {
  margin-bottom: var(--s-6);
  padding: var(--s-5);
  background: var(--c-bg-2);
  border-radius: var(--r-lg);
  border: 1px solid var(--c-border);
}
.project-info__desc-title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--w-bold);
  color: var(--c-text);
  margin-bottom: var(--s-3);
}
.project-info__desc p {
  font-size: var(--text-base);
  color: var(--c-text-muted);
  line-height: var(--lead-normal);
}

/* CTA button */
.proj-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  width: 100%;
  justify-content: center;
  font-size: var(--text-base);
  padding: 0.85em 1.5em;
}
.proj-cta svg { flex-shrink: 0; }

/* Project nav */
.project-nav {
  display: flex;
  justify-content: space-between;
  gap: var(--s-4);
  padding-block: var(--s-8);
  border-top: 1px solid var(--c-border);
  margin-top: var(--s-8);
}

.project-nav__btn {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  padding: var(--s-4) var(--s-5);
  border: 1.5px solid var(--c-border);
  border-radius: var(--r-md);
  color: var(--c-text);
  transition: border-color var(--t), box-shadow var(--t), background var(--t);
  max-width: 220px;
}
.project-nav__btn:hover {
  border-color: var(--c-electric);
  background: var(--c-bg-2);
}
.project-nav__btn span { display: flex; flex-direction: column; gap: 2px; }
.project-nav__btn small { font-size: var(--text-xs); color: var(--c-text-faint); text-transform: uppercase; letter-spacing: 0.06em; }
.project-nav__btn--next { margin-left: auto; text-align: right; }
.project-nav__btn--next span { align-items: flex-end; }

/* Lightbox */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: var(--s-4);
  padding: var(--s-6);
}
.lightbox[hidden] { display: none; }

.lightbox__close {
  position: absolute;
  top: var(--s-4);
  right: var(--s-4);
  color: rgba(255,255,255,0.7);
  padding: var(--s-2);
  border-radius: var(--r-sm);
  transition: color var(--t), background var(--t);
}
.lightbox__close:hover { color: #fff; background: rgba(255,255,255,0.1); }

.lightbox__content {
  max-width: 90vw;
  max-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox__img {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
  border-radius: var(--r-md);
}

.lightbox__nav {
  display: flex;
  align-items: center;
  gap: var(--s-5);
}
.lightbox__nav-btn {
  color: rgba(255,255,255,0.7);
  padding: var(--s-2);
  border-radius: var(--r-sm);
  transition: color var(--t), background var(--t);
}
.lightbox__nav-btn:hover { color: #fff; background: rgba(255,255,255,0.1); }
.lightbox__counter {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.6);
  min-width: 60px;
  text-align: center;
}

@media (min-width: 1024px) {
  .project-detail__layout { grid-template-columns: 3fr 2fr; }
}

/* ── Quote Modal ── */
.quote-modal {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--s-4);
}
.quote-modal[hidden] { display: none; }

.quote-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(13,17,23,0.72);
  backdrop-filter: blur(4px);
}

.quote-modal__panel {
  position: relative;
  background: var(--c-bg-2);
  border-radius: var(--r-xl, 1rem);
  border: 1px solid var(--c-border);
  padding: var(--s-8) var(--s-8) var(--s-8);
  width: 100%;
  max-width: 640px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 24px 64px rgba(0,0,0,0.25);
  animation: modal-in 0.22s ease;
}
@keyframes modal-in {
  from { opacity: 0; transform: translateY(16px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.quote-modal__close {
  position: absolute;
  top: var(--s-4);
  right: var(--s-4);
  color: var(--c-text-muted);
  padding: var(--s-2);
  border-radius: var(--r-sm);
  transition: color var(--t), background var(--t);
}
.quote-modal__close:hover { color: var(--c-text); background: var(--c-bg-3); }

.quote-modal__header { margin-bottom: var(--s-6); }
.quote-modal__eyebrow {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  color: var(--c-electric);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--s-2);
}
.quote-modal__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--w-bold);
  color: var(--c-text);
  margin-bottom: var(--s-2);
}
.quote-modal__sub {
  font-size: var(--text-sm);
  color: var(--c-text-muted);
}

/* Form */
.quote-form__row {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-4);
  margin-bottom: var(--s-4);
}
@media (min-width: 480px) {
  .quote-form__row { grid-template-columns: 1fr 1fr; }
}

.quote-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--s-1);
  margin-bottom: var(--s-4);
}
.quote-form__row .quote-form__field { margin-bottom: 0; }

.quote-form__field label {
  font-size: var(--text-sm);
  font-weight: var(--w-medium);
  color: var(--c-text-muted);
}
.quote-form__field label span { color: var(--c-electric); }

.quote-form__field input,
.quote-form__field textarea {
  background: var(--c-bg);
  border: 1.5px solid var(--c-border-2);
  border-radius: var(--r-md);
  padding: 0.65em 0.9em;
  font-size: var(--text-base);
  color: var(--c-text);
  font-family: inherit;
  transition: border-color var(--t), box-shadow var(--t);
  outline: none;
  width: 100%;
}
.quote-form__field input:focus,
.quote-form__field textarea:focus {
  border-color: var(--c-electric);
  box-shadow: 0 0 0 3px var(--c-electric-glow);
}
.quote-form__field input::placeholder,
.quote-form__field textarea::placeholder { color: var(--c-text-faint); }
.quote-form__field textarea { resize: vertical; min-height: 100px; }

.quote-form__ref-info {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-xs);
  color: var(--c-text-faint);
  background: var(--c-bg);
  border: 1px solid var(--c-border);
  border-radius: var(--r-sm);
  padding: var(--s-2) var(--s-3);
  margin-bottom: var(--s-5);
}
.quote-form__ref-info svg { flex-shrink: 0; color: var(--c-electric); }
.quote-form__ref-info strong { color: var(--c-text-muted); }

.quote-form__submit {
  width: 100%;
  justify-content: center;
  font-size: var(--text-base);
  padding: 0.85em 1.5em;
}

.quote-form__success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-4);
  padding: var(--s-8) 0;
  color: var(--c-electric);
  text-align: center;
}
.quote-form__success p {
  font-size: var(--text-lg);
  font-weight: var(--w-semi);
  color: var(--c-text);
}
.quote-form__success[hidden] { display: none; }
</style>

<script define:vars={{ images }}>
const lightbox = document.getElementById('lightbox');
const lightboxClose = document.getElementById('lightbox-close');
const lightboxPrev = document.getElementById('lightbox-prev');
const lightboxNext = document.getElementById('lightbox-next');
const lightboxImg = document.getElementById('lightbox-img');
const lightboxCounter = document.getElementById('lightbox-counter');
let currentIndex = 0;
const total = images.length;

function openLightbox(index) {
  currentIndex = index;
  updateLightbox();
  lightbox.hidden = false;
  document.body.style.overflow = 'hidden';
  lightboxClose.focus();
}

function closeLightbox() {
  lightbox.hidden = true;
  document.body.style.overflow = '';
}

function updateLightbox() {
  if (lightboxImg) {
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
  }
  if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${total}`;
}

document.querySelectorAll('[data-lightbox-trigger]').forEach(btn => {
  btn.addEventListener('click', () => {
    openLightbox(parseInt(btn.dataset.lightboxTrigger ?? '0'));
  });
});

lightboxClose?.addEventListener('click', closeLightbox);
lightboxPrev?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + total) % total; updateLightbox(); });
lightboxNext?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % total; updateLightbox(); });

lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

document.addEventListener('keydown', (e) => {
  if (lightbox?.hidden) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + total) % total; updateLightbox(); }
  if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % total; updateLightbox(); }
});

// ── Quote Modal ──
const quoteModal = document.getElementById('quote-modal');
const quoteModalClose = document.getElementById('quote-modal-close');
const quoteModalBackdrop = document.getElementById('quote-modal-backdrop');
const quoteForm = document.getElementById('quote-form');
const quoteSuccess = document.getElementById('quote-success');

function openQuoteModal() {
  if (!quoteModal) return;
  quoteModal.hidden = false;
  document.body.style.overflow = 'hidden';
  quoteModalClose?.focus();
}

function closeQuoteModal() {
  if (!quoteModal) return;
  quoteModal.hidden = true;
  document.body.style.overflow = '';
}

document.getElementById('open-quote-modal')?.addEventListener('click', openQuoteModal);
quoteModalClose?.addEventListener('click', closeQuoteModal);
quoteModalBackdrop?.addEventListener('click', closeQuoteModal);

document.addEventListener('keydown', (e) => {
  if (quoteModal?.hidden) return;
  if (e.key === 'Escape') closeQuoteModal();
});

quoteForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.currentTarget;
  const data = new FormData(form);
  try {
    const res = await fetch(form.action, {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' }
    });
    if (res.ok) {
      form.style.display = 'none';
      if (quoteSuccess) quoteSuccess.hidden = false;
      setTimeout(closeQuoteModal, 3000);
    }
  } catch (_) {}
});
</script>
