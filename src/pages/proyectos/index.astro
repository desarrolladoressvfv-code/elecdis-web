---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import projects from '../../data/projects.json';
import sectors from '../../data/sectors.json';

const sectorIds = ['todos', ...sectors.map(s => s.id)];
const sectorLabels: Record<string, string> = {
  todos: 'Todos',
  ...Object.fromEntries(sectors.map(s => [s.id, s.title]))
};
---
<BaseLayout
  title="Proyectos | ELECDIS – Electricidad & Diseño"
  description="Portafolio de proyectos eléctricos ejecutados por ELECDIS SpA en Santiago de Chile."
  pageUrl="/proyectos/"
>
  <Header currentPath="/proyectos/" />

  <main id="main-content">

    <!-- Hero -->
    <div class="page-hero">
      <div class="container">
        <nav aria-label="Ruta de navegación" class="breadcrumb">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Proyectos</li>
          </ol>
        </nav>
        <h1 class="page-hero__title">Proyectos ejecutados</h1>
        <p class="page-hero__sub">
          Instalaciones eléctricas realizadas con calidad y certificación SEC en todo Chile.
        </p>
      </div>
    </div>

    <section class="section proj-list" aria-labelledby="proj-list-title">
      <div class="container">

        <!-- Filtros -->
        <div class="filter-bar" role="group" aria-label="Filtrar por sector">
          <span class="filter-bar__label">Filtrar:</span>
          <div class="filter-bar__btns">
            {sectorIds.map(id => (
              <button
                class={`filter-btn${id === 'todos' ? ' is-active' : ''}`}
                data-filter={id}
                aria-pressed={id === 'todos' ? 'true' : 'false'}
              >
                {sectorLabels[id]}
              </button>
            ))}
          </div>
        </div>

        <!-- Grid -->
        <ul class="proj-grid" id="proj-grid" role="list">
          {projects.map((p, i) => (
            <li
              class="proj-card"
              data-sector={p.sectorId}
              data-anim
              data-anim-delay={String((i % 3) + 1)}
            >
              <a href={`/proyectos/${p.slug}/`} class="proj-card__img-wrap" tabindex="-1" aria-hidden="true">
                <img
                  src={p.cover}
                  alt={p.coverAlt}
                  class="proj-card__img"
                  loading="lazy"
                  decoding="async"
                />
                <span class="proj-card__overlay" aria-hidden="true">Ver proyecto →</span>
              </a>

              <div class="proj-card__body">
                <div class="proj-card__meta">
                  <span class="chip chip--electric">{p.sector}</span>
                  <span class="proj-card__year">{p.year}</span>
                </div>
                <h2 class="proj-card__title">
                  <a href={`/proyectos/${p.slug}/`}>{p.title}</a>
                </h2>
                <p class="proj-card__location">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {p.location}
                </p>
                <a href={`/proyectos/${p.slug}/`} class="proj-card__link">
                  Ver detalle
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <!-- Empty state -->
        <div class="proj-empty" id="proj-empty" hidden>
          <p>No hay proyectos en este sector todavía.</p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
/* Hero */
.page-hero {
  background: var(--c-electric);
  padding-top: calc(76px + var(--s-14));
  padding-bottom: var(--s-14);
  color: #fff;
}

.breadcrumb ol {
  display: flex;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.55);
  margin-bottom: var(--s-4);
  flex-wrap: wrap;
}
.breadcrumb li:not(:last-child)::after { content: '/'; margin-left: var(--s-2); }
.breadcrumb a { color: rgba(255,255,255,0.7); transition: color var(--t); }
.breadcrumb a:hover { color: #fff; }

.page-hero__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  font-weight: var(--w-bold);
  margin-bottom: var(--s-3);
}
.page-hero__sub {
  font-size: var(--text-lg);
  color: rgba(255,255,255,0.75);
  max-width: 520px;
}

/* Section */
.proj-list { background: var(--c-bg); }

/* Filtros */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--s-3);
  margin-bottom: var(--s-10);
  padding-bottom: var(--s-6);
  border-bottom: 1px solid var(--c-border);
}
.filter-bar__label {
  font-size: var(--text-sm);
  font-weight: var(--w-semi);
  color: var(--c-text-faint);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.filter-bar__btns {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
}
.filter-btn {
  padding: 0.4em 1.1em;
  border-radius: 999px;
  font-size: var(--text-sm);
  font-weight: var(--w-medium);
  color: var(--c-text-muted);
  border: 1.5px solid var(--c-border);
  background: transparent;
  transition: background var(--t), color var(--t), border-color var(--t);
  cursor: pointer;
  white-space: nowrap;
}
.filter-btn:hover {
  border-color: var(--c-electric);
  color: var(--c-electric);
}
.filter-btn.is-active {
  background: var(--c-electric);
  color: #fff;
  border-color: var(--c-electric);
}

/* Grid */
.proj-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-6);
}

/* Card */
.proj-card {
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg);
  overflow: hidden;
  transition: border-color var(--t), transform var(--t-slow), box-shadow var(--t-slow);
}
.proj-card:hover {
  border-color: rgba(29,78,216,0.3);
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}
.proj-card[hidden] { display: none; }

/* Image */
.proj-card__img-wrap {
  display: block;
  position: relative;
  overflow: hidden;
  aspect-ratio: 16/9;
}
.proj-card__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.proj-card:hover .proj-card__img { transform: scale(1.05); }

.proj-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(29,78,216,0.65);
  color: #fff;
  font-size: var(--text-base);
  font-weight: var(--w-semi);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--t-slow);
}
.proj-card:hover .proj-card__overlay { opacity: 1; }

/* Body */
.proj-card__body {
  padding: var(--s-5) var(--s-6) var(--s-6);
}

.proj-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-3);
}
.proj-card__year {
  font-size: var(--text-xs);
  color: var(--c-text-faint);
  font-weight: var(--w-medium);
}

.proj-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--w-bold);
  margin-bottom: var(--s-2);
  line-height: 1.3;
}
.proj-card__title a {
  color: var(--c-text);
  transition: color var(--t);
}
.proj-card__title a:hover { color: var(--c-electric); }

.proj-card__location {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: var(--text-sm);
  color: var(--c-text-faint);
  margin-bottom: var(--s-4);
}
.proj-card__location svg { flex-shrink: 0; color: var(--c-electric); }

.proj-card__link {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  font-weight: var(--w-semi);
  color: var(--c-electric);
  transition: gap var(--t);
}
.proj-card__link:hover { gap: var(--s-3); }

/* Empty */
.proj-empty {
  text-align: center;
  padding: var(--s-16);
  color: var(--c-text-muted);
  font-size: var(--text-lg);
}

@media (min-width: 640px)  { .proj-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .proj-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
const items = document.querySelectorAll<HTMLElement>('.proj-card');
const emptyEl = document.getElementById('proj-empty');

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter ?? 'todos';
    filterBtns.forEach(b => { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');

    let visible = 0;
    items.forEach(item => {
      const match = filter === 'todos' || item.dataset.sector === filter;
      item.hidden = !match;
      if (match) visible++;
    });
    if (emptyEl) emptyEl.hidden = visible > 0;
  });
});
</script>
