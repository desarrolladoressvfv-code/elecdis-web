---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import projects from '../../data/projects.json';
import sectors from '../../data/sectors.json';

const sectorIds = ['todos', ...sectors.map(s => s.id)];
const sectorLabels: Record<string, string> = {
  todos: 'Todos',
  ...Object.fromEntries(sectors.map(s => [s.id, s.title]))
};
---
<BaseLayout
  title="Proyectos | ELECDIS – Electricidad & Diseño"
  description="Portafolio de proyectos eléctricos ejecutados por ELECDIS SpA en Santiago de Chile."
  pageUrl="/proyectos/"
>
  <Header currentPath="/proyectos/" />

  <main id="main-content" class="projects-page">
    <!-- Page header -->
    <div class="page-hero">
      <div class="container page-hero__content">
        <nav aria-label="Ruta de navegación" class="breadcrumb">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Proyectos</li>
          </ol>
        </nav>
        <h1 class="page-hero__title">Proyectos ejecutados</h1>
        <p class="page-hero__subtitle">
          Conoce los proyectos eléctricos que hemos desarrollado con calidad y certificación SEC.
        </p>
      </div>
    </div>

    <section class="section" aria-labelledby="projects-list-title">
      <div class="container">
        <!-- Filtro por sector -->
        <div class="filter-bar" role="group" aria-label="Filtrar por sector">
          <span class="filter-bar__label">Filtrar:</span>
          {sectorIds.map(id => (
            <button
              class={`filter-btn ${id === 'todos' ? 'is-active' : ''}`}
              data-filter={id}
              aria-pressed={id === 'todos' ? 'true' : 'false'}
            >
              {sectorLabels[id]}
            </button>
          ))}
        </div>

        <!-- Grid de proyectos -->
        <ul
          class="projects-grid"
          id="projects-grid"
          role="list"
          aria-label="Lista de proyectos"
          aria-live="polite"
          aria-atomic="false"
        >
          {projects.map((project, i) => (
            <li
              class="project-thumb"
              data-sector={project.sectorId}
              data-animate
              data-animate-delay={String((i % 3) + 1)}
            >
              <!-- Imagen placeholder -->
              <a href={`/proyectos/${project.slug}/`} class="project-thumb__img-wrap" tabindex="-1" aria-hidden="true">
                <div class="img-placeholder project-thumb__img" aria-label={project.coverAlt}>
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  <span>{project.coverAlt}</span>
                </div>
              </a>

              <div class="project-thumb__body">
                <div class="project-thumb__meta">
                  <span class="project-thumb__sector">{project.sector}</span>
                  <span class="project-thumb__year">{project.year}</span>
                </div>
                <h2 class="project-thumb__title">
                  <a href={`/proyectos/${project.slug}/`}>{project.title}</a>
                </h2>
                <dl class="project-thumb__details">
                  <div>
                    <dt>Cliente</dt>
                    <dd>{project.client}</dd>
                  </div>
                  <div>
                    <dt>Ubicación</dt>
                    <dd>{project.location}</dd>
                  </div>
                </dl>
                <p class="project-thumb__summary">{project.summary}</p>
                <a href={`/proyectos/${project.slug}/`} class="project-thumb__link">
                  Ver detalle
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <!-- Empty state -->
        <div class="projects-empty" id="projects-empty" aria-live="polite" hidden>
          <p>No hay proyectos en este sector todavía.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
/* Page hero */
.page-hero {
  background: var(--color-primary);
  padding-top: calc(68px + var(--space-16));
  padding-bottom: var(--space-16);
  color: #fff;
}

.page-hero__content { }

.breadcrumb ol {
  display: flex;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}
.breadcrumb li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); }
.breadcrumb a { color: rgba(255,255,255,0.7); }
.breadcrumb a:hover { color: var(--color-accent); }

.page-hero__title {
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  font-weight: var(--weight-bold);
  margin-bottom: var(--space-4);
}
.page-hero__subtitle {
  font-size: var(--text-lg);
  color: rgba(255,255,255,0.75);
  max-width: 540px;
}

/* Filter */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-10);
}
.filter-bar__label {
  font-size: var(--text-sm);
  font-weight: var(--weight-semi);
  color: var(--color-text-muted);
}
.filter-btn {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: var(--weight-semi);
  color: var(--color-text-muted);
  border: 1.5px solid var(--color-border);
  transition: background var(--transition), color var(--transition), border-color var(--transition);
}
.filter-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.filter-btn.is-active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

/* Projects grid */
.projects-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

.project-thumb {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: box-shadow var(--transition), transform var(--transition);
}
.project-thumb:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
}

.project-thumb[hidden] { display: none; }

.project-thumb__img {
  height: 220px;
  border-radius: 0;
  border: none;
  border-bottom: 1px dashed var(--color-placeholder);
}

.project-thumb__body { padding: var(--space-6); }

.project-thumb__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}
.project-thumb__sector {
  font-size: var(--text-xs);
  font-weight: var(--weight-semi);
  color: var(--color-primary);
  background: rgba(11,31,75,0.08);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.project-thumb__year { font-size: var(--text-xs); color: var(--color-text-muted); }

.project-thumb__title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  margin-bottom: var(--space-4);
}
.project-thumb__title a {
  color: var(--color-primary);
  transition: color var(--transition);
}
.project-thumb__title a:hover { color: var(--color-primary-light); }

.project-thumb__details {
  display: flex;
  gap: var(--space-6);
  margin-bottom: var(--space-4);
}
.project-thumb__details div { flex: 1; }
.project-thumb__details dt { font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }
.project-thumb__details dd { font-size: var(--text-sm); font-weight: var(--weight-semi); color: var(--color-text); }

.project-thumb__summary {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-5);
}

.project-thumb__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-semi);
  color: var(--color-primary);
  transition: gap var(--transition);
}
.project-thumb__link:hover { gap: var(--space-3); }

/* Empty state */
.projects-empty {
  text-align: center;
  padding: var(--space-16);
  color: var(--color-text-muted);
  font-size: var(--text-lg);
}

@media (min-width: 640px) {
  .projects-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .projects-grid { grid-template-columns: repeat(3, 1fr); }
}
</style>

<script>
const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
const items = document.querySelectorAll<HTMLElement>('.project-thumb');
const emptyEl = document.getElementById('projects-empty');

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter ?? 'todos';

    filterBtns.forEach(b => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');

    let visibleCount = 0;
    items.forEach(item => {
      const match = filter === 'todos' || item.dataset.sector === filter;
      item.hidden = !match;
      if (match) visibleCount++;
    });

    if (emptyEl) emptyEl.hidden = visibleCount > 0;
  });
});
</script>
