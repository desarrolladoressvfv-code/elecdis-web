---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<BaseLayout
  title="Nosotros – ELECDIS SpA"
  description="Conoce la misión, visión y valores de ELECDIS SpA, empresa de ingeniería eléctrica dedicada a soluciones integrales para los sectores industrial, comercial y domiciliario."
  pageUrl="/nosotros"
>
  <Header currentPath="/nosotros" />

  <main id="main-content">

    <!-- Hero interior -->
    <section class="page-hero" aria-label="Nosotros">
      <div class="page-hero__bg" aria-hidden="true">
        <canvas id="about-canvas"></canvas>
      </div>
      <div class="container page-hero__inner">
        <p class="page-hero__eyebrow">Quiénes somos</p>
        <h1 class="page-hero__title">Nosotros</h1>
        <p class="page-hero__sub">
          Ingeniería eléctrica con experiencia técnica, innovación y compromiso al servicio de cada cliente.
        </p>
        <div class="page-hero__stats" aria-hidden="true">
          <div class="hero-stat">
            <span class="hero-stat__num">10+</span>
            <span class="hero-stat__label">Años de experiencia</span>
          </div>
          <div class="hero-stat__divider"></div>
          <div class="hero-stat">
            <span class="hero-stat__num">3</span>
            <span class="hero-stat__label">Sectores atendidos</span>
          </div>
          <div class="hero-stat__divider"></div>
          <div class="hero-stat">
            <span class="hero-stat__num">100%</span>
            <span class="hero-stat__label">Compromiso técnico</span>
          </div>
        </div>
      </div>
      <div class="page-hero__scroll" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </div>
    </section>

    <!-- Misión y Visión -->
    <section class="section mv-sec" aria-labelledby="mv-heading">
      <div class="container">
        <div class="sh sh--center mv-header" data-anim>
          <p class="sh__eyebrow">Nuestra razón de ser</p>
          <h2 class="sh__title" id="mv-heading">Misión &amp; Visión</h2>
        </div>
        <div class="mv-grid">

          <article class="mv-card" data-anim>
            <div class="mv-card__accent" aria-hidden="true"></div>
            <div class="mv-card__header">
              <div class="mv-card__icon" aria-hidden="true">
                <!-- Target / mission icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="6"/>
                  <circle cx="12" cy="12" r="2"/>
                </svg>
              </div>
              <h2 class="mv-card__heading">Misión</h2>
            </div>
            <p class="mv-card__text">
              Ser una empresa de ingeniería eléctrica dedicada al desarrollo y ejecución de soluciones integrales
              para los sectores industrial, comercial y domiciliario, mediante el diseño, fabricación e implementación
              de proyectos e instalaciones eléctricas. Nos comprometemos a entregar servicios de calidad, seguros y
              eficientes, adaptados a las necesidades de cada cliente, a través de la experiencia técnica, la innovación
              y el compromiso de nuestro equipo de trabajo, contribuyendo al funcionamiento y continuidad de sus operaciones.
            </p>
          </article>

          <article class="mv-card" data-anim data-anim-delay="1">
            <div class="mv-card__accent" aria-hidden="true"></div>
            <div class="mv-card__header">
              <div class="mv-card__icon" aria-hidden="true">
                <!-- Telescope / vision icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M12 15v6M9 21h6"/>
                </svg>
              </div>
              <h2 class="mv-card__heading">Visión</h2>
            </div>
            <p class="mv-card__text">
              Consolidarnos como una empresa referente en el rubro de la ingeniería eléctrica a nivel nacional,
              reconocida por la calidad de nuestros proyectos, la fabricación de tableros eléctricos y nuestra
              capacidad para entregar soluciones técnicas integrales. Aspiramos a fortalecer nuestra posición en
              el mercado mediante la innovación, el desarrollo tecnológico, la excelencia operacional y la
              construcción de relaciones comerciales duraderas, proyectándonos hacia un crecimiento sostenible y competitivo.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- Valores -->
    <section class="section values-sec" aria-labelledby="values-title">
      <div class="values-sec__bg" aria-hidden="true"></div>
      <div class="container" style="position:relative;z-index:1">
        <div class="sh sh--center" data-anim>
          <p class="sh__eyebrow">Lo que nos define</p>
          <h2 class="sh__title" id="values-title">Nuestros valores</h2>
          <p class="sh__sub">Los principios que guían cada decisión y cada proyecto que emprendemos.</p>
        </div>

        <ul class="values-grid" role="list">
          <li class="value-card" data-anim data-anim-delay="1">
            <div class="value-card__num" aria-hidden="true">01</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Shield / quality -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <h3 class="value-card__name">Calidad técnica</h3>
            <p class="value-card__desc">Estándares rigurosos en cada proyecto, respaldados por normativa vigente.</p>
          </li>
          <li class="value-card" data-anim data-anim-delay="2">
            <div class="value-card__num" aria-hidden="true">02</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Lightbulb / innovation -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2a7 7 0 0 1 7 7c0 2.69-1.52 5.04-3.75 6.27L15 17H9l-.25-1.73A7 7 0 0 1 5 9a7 7 0 0 1 7-7z"/>
                <path d="M9 17v1a3 3 0 0 0 6 0v-1"/>
              </svg>
            </div>
            <h3 class="value-card__name">Innovación</h3>
            <p class="value-card__desc">Adoptamos tecnología y procesos modernos para soluciones más eficientes.</p>
          </li>
          <li class="value-card" data-anim data-anim-delay="3">
            <div class="value-card__num" aria-hidden="true">03</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Lightning / safety -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            </div>
            <h3 class="value-card__name">Seguridad</h3>
            <p class="value-card__desc">Priorizamos la seguridad en cada instalación, para nuestro equipo y clientes.</p>
          </li>
          <li class="value-card" data-anim data-anim-delay="1">
            <div class="value-card__num" aria-hidden="true">04</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Handshake / commitment -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
            <h3 class="value-card__name">Compromiso</h3>
            <p class="value-card__desc">Relaciones duraderas con nuestros clientes, basadas en la confianza y la entrega.</p>
          </li>
          <li class="value-card" data-anim data-anim-delay="2">
            <div class="value-card__num" aria-hidden="true">05</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Pulse / efficiency -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <h3 class="value-card__name">Eficiencia</h3>
            <p class="value-card__desc">Optimizamos tiempos y recursos sin comprometer la calidad del resultado.</p>
          </li>
          <li class="value-card" data-anim data-anim-delay="3">
            <div class="value-card__num" aria-hidden="true">06</div>
            <div class="value-card__icon" aria-hidden="true">
              <!-- Trending up / growth -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                <polyline points="17 6 23 6 23 12"/>
              </svg>
            </div>
            <h3 class="value-card__name">Crecimiento sostenible</h3>
            <p class="value-card__desc">Proyectamos nuestra empresa hacia el futuro con una visión de largo plazo.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-sec" aria-label="Contacto">
      <div class="cta-sec__bg" aria-hidden="true">
        <div class="cta-sec__glow"></div>
      </div>
      <div class="container cta-inner" data-anim>
        <div class="cta-text">
          <p class="cta-eyebrow">¿Tienes un proyecto?</p>
          <h2 class="cta-title">Hablemos de tu próximo proyecto eléctrico</h2>
          <p class="cta-sub">Cuéntanos sobre tu necesidad y te entregamos una solución a medida.</p>
        </div>
        <a href="/#contacto" class="btn cta-btn">
          Solicitar cotización
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
/* ── Animations ── */
[data-anim] {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
[data-anim].visible { opacity: 1; transform: none; }
[data-anim-delay="1"] { transition-delay: 0.1s; }
[data-anim-delay="2"] { transition-delay: 0.2s; }
[data-anim-delay="3"] { transition-delay: 0.3s; }
[data-anim-delay="4"] { transition-delay: 0.4s; }

/* ── Hero interior ── */
.page-hero {
  position: relative;
  background: #0D1117;
  overflow: hidden;
  padding-top: calc(76px + var(--s-20));
  padding-bottom: var(--s-20);
  --c-text: #F9FAFB;
  --c-text-muted: #9CA3AF;
}
.page-hero__bg {
  position: absolute;
  inset: 0;
  opacity: 0.5;
}
.page-hero__bg canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.page-hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--s-5);
}
.page-hero__eyebrow {
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  color: #60A5FA;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.1s forwards;
}
.page-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  font-weight: var(--w-bold);
  color: #F9FAFB;
  line-height: 1.0;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.2s forwards;
}
.page-hero__sub {
  font-size: clamp(var(--text-base), 2vw, var(--text-lg));
  color: #9CA3AF;
  max-width: 520px;
  line-height: 1.65;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.3s forwards;
}

/* Hero stats */
.page-hero__stats {
  display: flex;
  align-items: center;
  gap: var(--s-6);
  margin-top: var(--s-4);
  padding: var(--s-5) var(--s-8);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--r-lg);
  backdrop-filter: blur(8px);
  opacity: 0;
  animation: fadeUp 0.7s ease 0.45s forwards;
}
.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.hero-stat__num {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: var(--w-bold);
  color: #60A5FA;
  line-height: 1;
}
.hero-stat__label {
  font-size: 0.65rem;
  font-weight: var(--w-medium);
  color: #6B7280;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.hero-stat__divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.1);
}

/* Scroll arrow */
.page-hero__scroll {
  position: absolute;
  bottom: var(--s-7);
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.25);
  animation: bounce 2s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(6px); }
}
@keyframes fadeUp {
  to { opacity: 1; transform: none; }
}

/* ── Misión / Visión ── */
.mv-sec {
  background: var(--c-bg);
  padding-block: var(--s-20);
}
.mv-header { margin-bottom: var(--s-12); }

.mv-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-6);
}
@media (min-width: 768px) { .mv-grid { grid-template-columns: 1fr 1fr; } }

.mv-card {
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg);
  padding: var(--s-9);
  display: flex;
  flex-direction: column;
  gap: var(--s-5);
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.4s ease, transform 0.3s ease, border-color 0.2s;
}
.mv-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--c-electric) 4%, transparent) 0%, transparent 60%);
  pointer-events: none;
}
.mv-card:hover {
  box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  transform: translateY(-3px);
  border-color: color-mix(in srgb, var(--c-electric) 30%, transparent);
}
.mv-card__accent {
  position: absolute;
  top: 0; left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(to bottom, var(--c-electric), color-mix(in srgb, var(--c-electric) 40%, transparent));
  border-radius: 4px 0 0 4px;
}
.mv-card__header {
  display: flex;
  align-items: center;
  gap: var(--s-4);
}
.mv-card__icon {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  background: color-mix(in srgb, var(--c-electric) 12%, transparent);
  border: 1.5px solid color-mix(in srgb, var(--c-electric) 25%, transparent);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-electric);
}
.mv-card__heading {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--w-bold);
  color: var(--c-text);
}
.mv-card__text {
  font-size: var(--text-base);
  color: var(--c-text-muted);
  line-height: 1.8;
  padding-left: calc(56px + var(--s-4));
}
@media (max-width: 480px) {
  .mv-card__text { padding-left: 0; }
}

/* ── Valores ── */
.values-sec {
  background: #0D1117;
  position: relative;
  overflow: hidden;
  padding-block: var(--s-20);
  --c-text: #F9FAFB;
  --c-text-muted: #9CA3AF;
}
.values-sec__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 40% at 10% 20%, rgba(30,58,138,0.25) 0%, transparent 60%),
    radial-gradient(ellipse 50% 50% at 90% 80%, rgba(30,58,138,0.15) 0%, transparent 60%);
  pointer-events: none;
}
.values-sec .sh__eyebrow { color: #60A5FA; }
.values-sec .sh__title { color: #F9FAFB; }
.values-sec .sh__sub {
  font-size: var(--text-base);
  color: #6B7280;
  max-width: 480px;
  margin: var(--s-3) auto 0;
  line-height: 1.65;
}

.values-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-4);
  margin-top: var(--s-12);
}
@media (min-width: 640px)  { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .values-grid { grid-template-columns: repeat(3, 1fr); } }

.value-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: var(--r-lg);
  padding: var(--s-7);
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  position: relative;
  overflow: hidden;
  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.2s, background 0.2s;
}
.value-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--c-electric), color-mix(in srgb, var(--c-electric) 20%, transparent));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s ease;
}
.value-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.4);
  border-color: rgba(96,165,250,0.2);
  background: rgba(255,255,255,0.05);
}
.value-card:hover::after { transform: scaleX(1); }

.value-card__num {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: var(--w-bold);
  color: rgba(96,165,250,0.4);
  letter-spacing: 0.1em;
  line-height: 1;
}
.value-card__icon {
  width: 50px;
  height: 50px;
  background: rgba(96,165,250,0.1);
  border: 1px solid rgba(96,165,250,0.2);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #60A5FA;
  margin-top: var(--s-1);
  transition: background 0.2s, border-color 0.2s;
}
.value-card:hover .value-card__icon {
  background: rgba(96,165,250,0.18);
  border-color: rgba(96,165,250,0.4);
}
.value-card__name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--w-bold);
  color: #F9FAFB;
  margin-top: var(--s-1);
}
.value-card__desc {
  font-size: var(--text-sm);
  color: #6B7280;
  line-height: 1.65;
}

/* ── CTA ── */
.cta-sec {
  background: var(--c-bg);
  position: relative;
  overflow: hidden;
  padding-block: var(--s-20);
}
.cta-sec__bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--c-electric) 0%, color-mix(in srgb, var(--c-electric) 70%, #0D1117) 100%);
}
.cta-sec__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 80% at 50% 50%, rgba(255,255,255,0.08) 0%, transparent 70%);
}
.cta-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--s-8);
}
@media (min-width: 768px) {
  .cta-inner { flex-direction: row; justify-content: space-between; text-align: left; }
}
.cta-eyebrow {
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  color: rgba(255,255,255,0.65);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: var(--s-2);
}
.cta-title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, var(--text-3xl));
  font-weight: var(--w-bold);
  color: #fff;
  line-height: 1.2;
}
.cta-sub {
  font-size: var(--text-base);
  color: rgba(255,255,255,0.75);
  margin-top: var(--s-3);
  max-width: 440px;
  line-height: 1.6;
}
.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  background: #fff;
  color: var(--c-electric);
  border: none;
  flex-shrink: 0;
  font-weight: var(--w-bold);
  font-size: var(--text-base);
  padding: var(--s-4) var(--s-8);
  border-radius: var(--r-md);
  transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}
.cta-btn:hover {
  background: #F0F9FF;
  box-shadow: 0 8px 32px rgba(0,0,0,0.2);
  transform: translateY(-2px);
}
.cta-btn svg { transition: transform 0.2s; }
.cta-btn:hover svg { transform: translateX(4px); }
</style>

<script>
/* Canvas eléctrico del hero */
(function () {
  const canvas = document.getElementById('about-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const NODE_COUNT = 32;
  const MAX_DIST = 170;
  const PULSE_INTERVAL = 1800;

  interface Node { x: number; y: number; vx: number; vy: number; r: number; }
  interface Pulse { fromX: number; fromY: number; toX: number; toY: number; t: number; speed: number; }

  let W = 0, H = 0;
  let nodes: Node[] = [];
  let pulses: Pulse[] = [];
  let lastPulse = 0;
  let raf = 0;

  function resize() {
    const rect = canvas!.parentElement!.getBoundingClientRect();
    W = canvas!.width  = rect.width;
    H = canvas!.height = rect.height;
  }

  function init() {
    nodes = Array.from({ length: NODE_COUNT }, () => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
      r: Math.random() * 1.5 + 1,
    }));
  }

  function spawnPulse() {
    const edges: [number, number][] = [];
    for (let i = 0; i < nodes.length; i++)
      for (let j = i + 1; j < nodes.length; j++)
        if (Math.hypot(nodes[i].x - nodes[j].x, nodes[i].y - nodes[j].y) < MAX_DIST)
          edges.push([i, j]);
    if (!edges.length) return;
    const [a, b] = edges[Math.floor(Math.random() * edges.length)];
    pulses.push({ fromX: nodes[a].x, fromY: nodes[a].y, toX: nodes[b].x, toY: nodes[b].y, t: 0, speed: 0.02 + Math.random() * 0.015 });
  }

  function draw(ts: number) {
    ctx!.clearRect(0, 0, W, H);
    for (const n of nodes) {
      n.x += n.vx; n.y += n.vy;
      if (n.x < 0 || n.x > W) n.vx *= -1;
      if (n.y < 0 || n.y > H) n.vy *= -1;
    }
    if (ts - lastPulse > PULSE_INTERVAL) { spawnPulse(); lastPulse = ts; }
    pulses = pulses.filter(p => p.t <= 1);
    for (const p of pulses) p.t += p.speed;

    for (let i = 0; i < nodes.length; i++)
      for (let j = i + 1; j < nodes.length; j++) {
        const d = Math.hypot(nodes[i].x - nodes[j].x, nodes[i].y - nodes[j].y);
        if (d > MAX_DIST) continue;
        ctx!.strokeStyle = `rgba(96,165,250,${(1 - d / MAX_DIST) * 0.22})`;
        ctx!.lineWidth = 0.8;
        ctx!.beginPath();
        ctx!.moveTo(nodes[i].x, nodes[i].y);
        ctx!.lineTo(nodes[j].x, nodes[j].y);
        ctx!.stroke();
      }

    for (const p of pulses) {
      const x = p.fromX + (p.toX - p.fromX) * p.t;
      const y = p.fromY + (p.toY - p.fromY) * p.t;
      const g = ctx!.createRadialGradient(x, y, 0, x, y, 10);
      g.addColorStop(0, 'rgba(147,210,255,0.9)');
      g.addColorStop(0.3, 'rgba(96,165,250,0.5)');
      g.addColorStop(1, 'rgba(96,165,250,0)');
      ctx!.fillStyle = g;
      ctx!.beginPath(); ctx!.arc(x, y, 10, 0, Math.PI * 2); ctx!.fill();
    }

    for (const n of nodes) {
      ctx!.fillStyle = 'rgba(96,165,250,0.5)';
      ctx!.beginPath(); ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx!.fill();
    }
    raf = requestAnimationFrame(draw);
  }

  resize(); init(); raf = requestAnimationFrame(draw);
  window.addEventListener('resize', resize, { passive: true });
})();

/* Scroll animations */
(function () {
  const els = document.querySelectorAll('[data-anim]');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(el => io.observe(el));
})();
</script>
