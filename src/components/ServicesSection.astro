---
import services from '../data/services.json';
---
<section class="section services" id="servicios" aria-labelledby="srv-title">
  <div class="container">

    <div class="sh" data-anim>
      <p class="sh__eyebrow">Lo que hacemos</p>
      <h2 class="sh__title" id="srv-title">Nuestros Servicios</h2>
      <p class="sh__sub">
        Soluciones eléctricas integrales con certificación SEC. Desde el diseño hasta la puesta en marcha.
      </p>
    </div>

    <ul class="srv-grid" role="list">
      {services.map((s, i) => (
        <li class="srv-card" data-anim data-anim-delay={String(i + 1)}>
          <div class="srv-card__number" aria-hidden="true">0{i + 1}</div>
          <div class="srv-card__icon" aria-hidden="true">{s.icon}</div>
          <h3 class="srv-card__title">{s.title}</h3>
          <p class="srv-card__desc">{s.description}</p>
          <ul class="srv-card__features" role="list">
            {s.features.map(f => (
              <li class="srv-feat">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><polyline points="9,12 11,14 15,10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="/#contacto" class="srv-card__link" aria-label={`Cotizar ${s.title}`}>
            Cotizar
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <!-- Borde eléctrico en hover -->
          <div class="srv-card__border" aria-hidden="true"></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.services { background: var(--c-bg-2); }

.srv-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-5);
}

.srv-card {
  position: relative;
  background: var(--c-bg-3);
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg);
  padding: var(--s-8);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: border-color var(--t), transform var(--t-slow), box-shadow var(--t-slow);
}
.srv-card:hover {
  border-color: rgba(0,194,255,0.3);
  transform: translateY(-6px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1), 0 0 0 1px rgba(14,165,233,0.08) inset;
}

.srv-card__number {
  position: absolute;
  top: var(--s-5);
  right: var(--s-6);
  font-family: var(--font-display);
  font-size: 3.5rem;
  font-weight: var(--w-black);
  color: rgba(255,255,255,0.03);
  line-height: 1;
  letter-spacing: -0.04em;
  user-select: none;
}

.srv-card__icon {
  font-size: 2rem;
  margin-bottom: var(--s-5);
  width: 52px;
  height: 52px;
  background: var(--c-electric-glow);
  border: 1px solid rgba(0,194,255,0.2);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.srv-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--w-bold);
  color: var(--c-text);
  margin-bottom: var(--s-3);
}

.srv-card__desc {
  font-size: var(--text-sm);
  color: var(--c-text-muted);
  line-height: var(--lead-normal);
  margin-bottom: var(--s-5);
  flex: 1;
}

.srv-card__features {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-bottom: var(--s-6);
}

.srv-feat {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: var(--c-text-muted);
}
.srv-feat svg { color: var(--c-electric); flex-shrink: 0; }

.srv-card__link {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  font-weight: var(--w-semi);
  color: var(--c-electric);
  transition: gap var(--t);
  margin-top: auto;
}
.srv-card__link:hover { gap: var(--s-3); }

/* Borde animado */
.srv-card__border {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--c-electric), var(--c-amber), transparent);
  opacity: 0;
  transition: opacity var(--t-slow);
}
.srv-card:hover .srv-card__border { opacity: 1; }

@media (min-width: 640px) { .srv-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .srv-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
