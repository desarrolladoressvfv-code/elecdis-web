---
import services from '../data/services.json';
---
<section class="section services" id="servicios" aria-labelledby="srv-title">
  <div class="container">

    <div class="sh sh--center" data-anim>
      <p class="sh__eyebrow">Lo que hacemos</p>
      <h2 class="sh__title" id="srv-title">Nuestros Servicios</h2>
      <p class="sh__sub">
        Soluciones eléctricas integrales con certificación SEC. Desde el diseño hasta la puesta en marcha.
      </p>
    </div>

    <ul class="srv-grid" role="list">
      {services.map((s, i) => (
        <li class="srv-card" data-anim data-anim-delay={String(i + 1)}>
          <img
            src={s.image}
            alt={s.title}
            class="srv-card__bg"
            loading="lazy"
            decoding="async"
          />
          <div class="srv-card__overlay"></div>

          <div class="srv-card__body">
            <h3 class="srv-card__title">{s.title}</h3>
            <p class="srv-card__desc">{s.description}</p>

            <ul class="srv-card__features" role="list">
              {s.features.map(f => (
                <li class="srv-feat">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    <polyline points="9,12 11,14 15,10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <a href="/#contacto" class="srv-card__cta" aria-label={`Cotizar ${s.title}`}>
              Cotizar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.services { background: var(--c-dark); }

.services .sh__eyebrow { color: var(--c-electric); }
.services .sh__title  { color: #fff; }
.services .sh__sub    { color: rgba(255,255,255,0.6); }

.srv-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-5);
}

.srv-card {
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  min-height: 420px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: transform var(--t-slow), box-shadow var(--t-slow);
}
.srv-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 48px rgba(0,0,0,0.5);
}

.srv-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.srv-card:hover .srv-card__bg { transform: scale(1.06); }

.srv-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(5,10,20,0.95) 0%,
    rgba(5,10,20,0.6) 50%,
    rgba(5,10,20,0.15) 100%
  );
  transition: background var(--t-slow);
}
.srv-card:hover .srv-card__overlay {
  background: linear-gradient(
    to top,
    rgba(5,10,20,0.98) 0%,
    rgba(5,10,20,0.75) 55%,
    rgba(5,10,20,0.25) 100%
  );
}

.srv-card__body {
  position: relative;
  padding: var(--s-7) var(--s-7) var(--s-7);
  display: flex;
  flex-direction: column;
}

.srv-card__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--w-bold);
  color: #fff;
  margin-bottom: var(--s-3);
  line-height: 1.2;
}

.srv-card__desc {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.7);
  line-height: var(--lead-normal);
  margin-bottom: var(--s-5);
  max-width: 340px;
}

.srv-card__features {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-bottom: var(--s-6);
}

.srv-feat {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.65);
}
.srv-feat svg { color: var(--c-electric); flex-shrink: 0; }

.srv-card__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  font-weight: var(--w-semi);
  color: #fff;
  background: var(--c-electric);
  padding: 0.55em 1.2em;
  border-radius: 999px;
  align-self: flex-start;
  transition: background var(--t), gap var(--t);
}
.srv-card__cta:hover {
  background: var(--c-electric-dim);
  gap: var(--s-3);
}

@media (min-width: 768px)  { .srv-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
