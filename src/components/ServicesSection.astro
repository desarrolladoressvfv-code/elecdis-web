---
import services from '../data/services.json';

const clientRubros = [
  { icon: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z', label: 'Salud' },
  { icon: 'M2 20h20M6 20V10l6-6 6 6v10M10 20v-6h4v6', label: 'Industrial' },
  { icon: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10', label: 'Comercial' },
  { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', label: 'Institucional' },
  { icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z', label: 'Residencial' },
];
---
<section class="section services" id="servicios" aria-labelledby="srv-title">
  <div class="container">

    <div class="sh" data-anim>
      <p class="sh__eyebrow">Lo que hacemos</p>
      <h2 class="sh__title" id="srv-title">Nuestros Servicios</h2>
      <p class="sh__sub">
        Soluciones eléctricas integrales con certificación SEC. Desde el diseño hasta la puesta en marcha.
      </p>
    </div>

    <!-- Cards: imagen arriba + contenido abajo -->
    <ul class="srv-grid" role="list">
      {services.map((s, i) => (
        <li class="srv-card" data-anim data-anim-delay={String(i + 1)}>
          <div class="srv-card__img-wrap">
            <img src={s.image} alt={s.title} class="srv-card__img" loading="lazy" decoding="async" />
          </div>
          <div class="srv-card__body">
            <h3 class="srv-card__title">{s.title}</h3>
            <p class="srv-card__desc">{s.description}</p>
            <ul class="srv-card__features" role="list">
              {s.features.map(f => (
                <li class="srv-feat">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    <polyline points="9,12 11,14 15,10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href="/#contacto" class="srv-card__cta" aria-label={`Cotizar ${s.title}`}>
              Cotizar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- Franja: rubros que atendemos -->
    <div class="rubros" data-anim>
      <p class="rubros__label">Atendemos</p>
      <ul class="rubros__list" role="list">
        {clientRubros.map(r => (
          <li class="rubro">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={r.icon}/>
            </svg>
            {r.label}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
.services { background: var(--c-bg-2); }

/* Grid de cards */
.srv-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-6);
  margin-bottom: var(--s-10);
}
@media (min-width: 768px) { .srv-grid { grid-template-columns: repeat(3, 1fr); } }

/* Card */
.srv-card {
  display: flex;
  flex-direction: column;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--c-bg);
  border: 1px solid var(--c-border);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  transition: transform var(--t-slow), box-shadow var(--t-slow);
}
.srv-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.12);
}

/* Imagen */
.srv-card__img-wrap {
  overflow: hidden;
  height: 220px;
  flex-shrink: 0;
}
.srv-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  display: block;
}
.srv-card:hover .srv-card__img { transform: scale(1.05); }

/* Cuerpo */
.srv-card__body {
  padding: var(--s-6) var(--s-7) var(--s-7);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.srv-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--w-bold);
  color: var(--c-text);
  margin-bottom: var(--s-3);
}

.srv-card__desc {
  font-size: var(--text-sm);
  color: var(--c-text-muted);
  line-height: var(--lead-normal);
  margin-bottom: var(--s-5);
}

.srv-card__features {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-bottom: var(--s-6);
  flex: 1;
}
.srv-feat {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: var(--c-text-muted);
}
.srv-feat svg { color: var(--c-electric); flex-shrink: 0; }

.srv-card__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  font-weight: var(--w-semi);
  color: var(--c-electric);
  border: 1.5px solid var(--c-electric);
  padding: 0.55em 1.2em;
  border-radius: 999px;
  align-self: flex-start;
  transition: background var(--t), color var(--t), gap var(--t);
}
.srv-card__cta:hover {
  background: var(--c-electric);
  color: #fff;
  gap: var(--s-3);
}

/* Franja rubros */
.rubros {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--s-4) var(--s-6);
  padding: var(--s-6) var(--s-8);
  background: var(--c-bg);
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg);
}

.rubros__label {
  font-size: var(--text-xs);
  font-weight: var(--w-semi);
  color: var(--c-text-faint);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.rubros__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2) var(--s-4);
  flex: 1;
}

.rubro {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  font-weight: var(--w-medium);
  color: var(--c-text-muted);
  padding: var(--s-2) var(--s-4);
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-radius: 999px;
  transition: border-color var(--t), color var(--t);
}
.rubro:hover { border-color: var(--c-electric); color: var(--c-electric); }
.rubro svg { color: var(--c-electric); flex-shrink: 0; }
</style>
