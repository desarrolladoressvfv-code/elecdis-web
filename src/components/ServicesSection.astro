---
import services from '../data/services.json';
---
<section class="section services" id="servicios" aria-labelledby="srv-title">
  <div class="container">

    <div class="sh" data-anim>
      <p class="sh__eyebrow">Lo que hacemos</p>
      <h2 class="sh__title" id="srv-title">Nuestros Servicios</h2>
      <p class="sh__sub">
        Soluciones eléctricas integrales con certificación SEC. Desde el diseño hasta la puesta en marcha.
      </p>
    </div>

    <ul class="srv-list" role="list">
      {services.map((s, i) => (
        <li class={`srv-row${i % 2 === 1 ? ' srv-row--reverse' : ''}`} data-anim data-anim-delay={String(i + 1)}>

          <div class="srv-row__img-wrap">
            <img
              src={s.image}
              alt={s.title}
              class="srv-row__img"
              loading="lazy"
              decoding="async"
            />
            <div class="srv-row__num" aria-hidden="true">0{i + 1}</div>
          </div>

          <div class="srv-row__body">
            <h3 class="srv-row__title">{s.title}</h3>
            <p class="srv-row__desc">{s.description}</p>

            <ul class="srv-row__features" role="list">
              {s.features.map(f => (
                <li class="srv-feat">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    <polyline points="9,12 11,14 15,10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <a href="/#contacto" class="btn btn--electric srv-row__cta" aria-label={`Cotizar ${s.title}`}>
              Cotizar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>

        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.services { background: var(--c-bg-2); }

.srv-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  border: 1px solid var(--c-border);
  border-radius: var(--r-xl, 1.25rem);
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}

/* Fila */
.srv-row {
  display: grid;
  grid-template-columns: 1fr;
  min-height: 340px;
  background: var(--c-bg-2);
  transition: background var(--t);
}
.srv-row:hover { background: var(--c-bg); }

@media (min-width: 768px) {
  .srv-row               { grid-template-columns: 1fr 1fr; }
  .srv-row--reverse      { direction: rtl; }
  .srv-row--reverse > *  { direction: ltr; }
}

/* Imagen */
.srv-row__img-wrap {
  position: relative;
  overflow: hidden;
  min-height: 260px;
}
@media (min-width: 768px) {
  .srv-row__img-wrap { min-height: unset; }
}

.srv-row__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.srv-row:hover .srv-row__img { transform: scale(1.04); }

.srv-row__num {
  position: absolute;
  bottom: var(--s-4);
  left: var(--s-5);
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: var(--w-bold);
  color: rgba(255,255,255,0.9);
  line-height: 1;
  text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  letter-spacing: -0.04em;
}

/* Texto */
.srv-row__body {
  padding: var(--s-8) var(--s-8);
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-left: 1px solid var(--c-border);
}
.srv-row--reverse .srv-row__body {
  border-left: none;
  border-right: 1px solid var(--c-border);
}
@media (max-width: 767px) {
  .srv-row__body {
    border-left: none;
    border-top: 1px solid var(--c-border);
  }
}

.srv-row__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--w-bold);
  color: var(--c-text);
  margin-bottom: var(--s-3);
}

.srv-row__desc {
  font-size: var(--text-base);
  color: var(--c-text-muted);
  line-height: var(--lead-normal);
  margin-bottom: var(--s-5);
}

.srv-row__features {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-bottom: var(--s-6);
}

.srv-feat {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-sm);
  color: var(--c-text-muted);
}
.srv-feat svg { color: var(--c-electric); flex-shrink: 0; }

.srv-row__cta {
  align-self: flex-start;
}
</style>
