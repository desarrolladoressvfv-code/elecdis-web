---
interface Props {
  class?: string;
  invert?: boolean; // true = logo blanco (footer oscuro)
}
const { class: className = '', invert = false } = Astro.props;
---
<img
  src="/images/logo2-elecdis-transparent.png"
  alt="ELECDIS – Servicio de Ingeniería Eléctrica y Diseño Industrial"
  class={`logo-img ${invert ? 'logo-img--invert' : ''} ${className}`}
  draggable="false"
/>

<style>
.logo-img {
  display: block;
  /* PNG transparente con contenido negro: se ve directo sobre fondo claro */
}
.logo-img--invert {
  /* Footer oscuro: negro → blanco */
  filter: invert(1);
}
</style>
